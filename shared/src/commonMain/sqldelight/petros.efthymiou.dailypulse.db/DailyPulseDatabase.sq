CREATE TABLE Article (
    title TEXT NOT NULL,
    desc TEXT,
    date TEXT NOT NULL,
    imageUrl TEXT

);

insetArticle:
INSERT INTO Article(title, desc, date , imageUrl)
VALUES(?,?,?,?);

selectAllArticles:
SELECT Article.*
FROM Article;

removeAllArticles:
DELETE FROM Article;

CREATE TABLE Sources(
    name TEXT,
    description TEXT,
    language TEXT
);

insertSource:
INSERT INTO Sources(name,description,language)
VALUES(?,?,?);


selectAllSources:
SELECT Sources.*
FROM Sources;